#include <zephyr/dt-bindings/regulator/npm13xx.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	/delete-node/ leds;
	/delete-node/ buttons;
	/delete-node/ pwmleds;

	aliases{
		/delete-property/ led0;
		/delete-property/ led1;
		/delete-property/ led2;
		/delete-property/ led3;
		/delete-property/ sw0;
		/delete-property/ sw1;
		/delete-property/ sw2;
		/delete-property/ sw3;
		/delete-property/ pwm-led0;
		/delete-property/ mcuboot-button0;
		/delete-property/ mcuboot-led0;
	};

	nordic_expansion_header: nordic_expansion_header {
		/delete-property/ gpio-map-mask;
		/delete-property/ gpio-map-pass-thru;
		/delete-property/ gpio-map;
		/delete-property/ compatible;
		/delete-property/ #gpio-cells;
		status = "disabled";
	};

	chosen {
		zephyr,console = &uart20;
		zephyr,shell-uart = &uart20;
	};

	dw3000_irq: dw3000-irq {
		compatible = "nordic,gpio-pins";
		gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	heart_led: heart-led {
		compatible = "nordic,gpio-pins";
		gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;
		status = "okay";
	};
	dw3000_rst: dw3000-rst {
		compatible = "nordic,gpio-pins";
		gpios = <&gpio2 10 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	dw3000_wakeup: dw3000-wakeup {
		compatible = "nordic,gpio-pins";
		gpios = <&gpio2 7 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};
	dw3000_pd: dw3000-pd {
		compatible = "nordic,gpio-pins";
		gpios = <&gpio2 0 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	dw3000_sync: dw3000-sync {
		compatible = "nordic,gpio-pins";
		gpios = <&gpio0 3 GPIO_ACTIVE_LOW>;
		status = "okay";
	};
};

&pinctrl{
	/omit-if-no-ref/ uart21_only_default: uart21_only_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 12)>;
		};
		group2 {
			psels = <NRF_PSEL(UART_RX, 1, 13)>;
			bias-pull-up;
		};
	};
	/omit-if-no-ref/ uart21_only_sleep: uart21_only_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 12)>,
					<NRF_PSEL(UART_RX, 1, 13)>;
			low-power-enable;
		};
	};
	/omit-if-no-ref/ uart20_only_default: uart20_only_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 9)>,
                    		<NRF_PSEL(UART_RX, 1, 6)>;
		};
	};
	/omit-if-no-ref/ uart20_only_sleep: uart20_only_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 9)>,
                    		<NRF_PSEL(UART_RX, 1, 6)>;
			bias-pull-up;
			low-power-enable;
		};
	};

	/omit-if-no-ref/ spi00_default: spi00_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 2, 6)>,
					<NRF_PSEL(SPIM_MOSI, 2, 8)>,
					<NRF_PSEL(SPIM_MISO, 2, 9)>;
		};
	};

	/omit-if-no-ref/ spi00_sleep: spi00_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 2, 6)>,
					<NRF_PSEL(SPIM_MOSI, 2, 8)>,
					<NRF_PSEL(SPIM_MISO, 2, 9)>;
			low-power-enable;
		};
	};
	/omit-if-no-ref/ i2c22_default: i2c22_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 5)>,
					<NRF_PSEL(TWIM_SCL, 1, 4)>;
		};
	};
	/omit-if-no-ref/ i2c22_sleep: i2c22_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 5)>,
					<NRF_PSEL(TWIM_SCL, 1, 4)>;
			low-power-enable;
		};
	};
	/omit-if-no-ref/ i2c21_default: i2c21_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 10)>,
					<NRF_PSEL(TWIM_SCL, 1, 11)>;
		};
	};
	/omit-if-no-ref/ i2c21_sleep: i2c21_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 10)>,
					<NRF_PSEL(TWIM_SCL, 1, 11)>;
			low-power-enable;
		};
	};
};

&uart21 {
	current-speed = <115200>;
	pinctrl-0 = <&uart21_only_default>;
	pinctrl-1 = <&uart21_only_sleep>;
	pinctrl-names = "default", "sleep";
	status = "disabled";
};

&uart20 {
	current-speed = <115200>;
	pinctrl-0 = <&uart20_only_default>;
	pinctrl-1 = <&uart20_only_sleep>;
	pinctrl-names = "default", "sleep";
	status = "okay";
};

&pwm20{
	/delete-property/ pinctrl-0;
	/delete-property/ pinctrl-1;
	/delete-property/ pinctrl-names;
	status = "disabled";
};

&uicr {
	nfct-pins-as-gpios;
};

&nfct {
	status = "disabled";
};

&adc {
	status = "disabled";
};

nordic_expansion_spi: &spi22 {
	status = "disabled";
};

&lfxo {
	load-capacitors = "external";
	load-capacitance-femtofarad = <12000>;
};

&spi00 {
	status = "okay";
	cs-gpios = <&gpio2 5 GPIO_ACTIVE_HIGH>;
	pinctrl-0 = <&spi00_default>;
	pinctrl-1 = <&spi00_sleep>;
	pinctrl-names = "default", "sleep";

	/delete-node/ mx25r6435f@0;
};

i2c_npm13xx: &i2c22 {
	status = "okay";
	pinctrl-0 = <&i2c22_default>;
	pinctrl-1 = <&i2c22_sleep>;
	pinctrl-names = "default", "sleep";
};

i2c_bma253: &i2c21 {
	status = "okay";
	pinctrl-0 = <&i2c21_default>;
	pinctrl-1 = <&i2c21_sleep>;
	pinctrl-names = "default", "sleep";
};


&i2c_npm13xx {
	npm1300_ek_pmic: pmic@6b {
		compatible = "nordic,npm1300";
		reg = <0x6b>;

		/* host-int-gpios = <&gpio0 4 0>;
		pmic-int-pin = <3>; */

		ship-to-active-time-ms = <96>;
		long-press-reset = "one-button";
		npm1300_gpio: gpio-controller {
			compatible = "nordic,npm1300-gpio";
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <5>;
		};

		npm1300_ek_charger: charger {
			compatible = "nordic,npm1300-charger";
			vbus-limit-microamp = <100000>;

			thermistor-ohms = <10000>;
			thermistor-beta = <3380>;
			trickle-microvolt = <2500000>;

			/*
			 * 【关键】必须显式写 charging-enable。
			 * 它是布尔属性、没有 default，驱动里是
			 *     if (config->charging_enable) {
			 *             ... CHGR_OFFSET_EN_SET = 1 ...
			 *     }
			 * 不写 => 从不置 EN_SET 位 => 充电永不启动。
			 */
			charging-enable;

			/*
			 * 允许在低于 vbatlow 阈值时也充电。
			 * 没有这一条时，电池电压很低（本机读数 ~2.95V）会被拒绝充电。
			 */
			vbatlow-charge-enable;

			/*
			 * 不要写 disable-recharge：它禁止充满后的自动再充电，
			 * 会让电池掉电后无法回充。
			 */

			dietemp-resume-millidegrees = <100000>;
			dietemp-stop-millidegrees = <110000>;

			/* 单节 Li-ion 满充 4.2V；官方参考用 4.15V。
			 * 原来的 3.5V 太低，电池几乎充不进电。 */
			term-microvolt = <4150000>;
			term-warm-microvolt = <4000000>;

			current-microamp = <32000>;
			dischg-limit-microamp = <1000000>;

			/* 充满判定电流 = current-microamp 的百分比。
			 * 绑定里是枚举 10 或 20，默认 10。 */
			term-current-percent = <10>;
		};

		npm1300_ek_leds: leds {
			compatible = "nordic,npm1300-led";
			nordic,led0-mode = "error";
			nordic,led1-mode = "charging";
			nordic,led2-mode = "host";
		};

		regulators {
			compatible = "nordic,npm1300-regulator";
			buck1: BUCK1 {
				status = "okay";
				regulator-boot-on;
				regulator-init-microvolt = <3300000>;
				regulator-min-microvolt = <1000000>;
				regulator-max-microvolt = <3300000>;
				regulator-initial-mode = <NPM13XX_BUCK_MODE_AUTO>;
			};
			buck2: BUCK2 {
				status = "okay";
				regulator-boot-on;
				regulator-init-microvolt = <3300000>;
				regulator-min-microvolt = <1000000>;
				regulator-max-microvolt = <3300000>;
				regulator-initial-mode = <NPM13XX_BUCK_MODE_AUTO>;
			};
			ldo1: LDO1 {
				regulator-min-microvolt = <1000000>;
       				regulator-max-microvolt = <3300000>;
				regulator-initial-mode = <NPM13XX_LDSW_MODE_LDSW>;
				soft-start-microamp = <100000>;
			};
			ldo2: LDO2 {
				regulator-min-microvolt = <1000000>;
        			regulator-max-microvolt = <3300000>;
				regulator-initial-mode = <NPM13XX_LDSW_MODE_LDSW>;
				soft-start-microamp = <100000>;
			};
		};
	};
};

