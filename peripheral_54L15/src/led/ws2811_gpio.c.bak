LOG_MODULE_REGISTER(ws2811_gpio);

static const struct gpio_dt_spec led_gpio = GPIO_DT_SPEC_GET(DT_NODELABEL(ws2811_gpio), gpios);

#define CONFIG_DELAY_T1H 80
#define CONFIG_DELAY_T1L 80
#define CONFIG_DELAY_T0H 40
#define CONFIG_DELAY_T0L 120



#if 1
struct LED_RGB_T rgbcolors[] = {
	{0xFF, 0x00, 0x00}, /* red */
	{0x00, 0xFF, 0x00}, /* green */
	{0x00, 0x00, 0xFF}, /* blue */
	{0xFF, 0xFF, 0x00}, /* yellow */
