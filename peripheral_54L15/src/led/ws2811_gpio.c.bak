#define SET_HIGH "str %[p], [%[r], #0]\n" /* OUTSET = BIT(LED_PIN) */
#define SET_LOW "str %[p], [%[r], #4]\n"  /* OUTCLR = BIT(LED_PIN) */

#define NOPS(i, _) "nop\n"
#define NOP_N_TIMES(n) LISTIFY(n, NOPS, ())

/* Send out a 1 bit's pulse */
#define ONE_BIT(base, pin) do {					\
	__asm volatile (SET_HIGH				\
			NOP_N_TIMES(CONFIG_DELAY_T1H)		\
			SET_LOW					\
			NOP_N_TIMES(CONFIG_DELAY_T1L)		\
			::					\
			[r] "l" (base),				\
			[p] "l" (pin)); } while (false)

/* Send out a 0 bit's pulse */
#define ZERO_BIT(base, pin) do {				\
	__asm volatile (SET_HIGH				\
			NOP_N_TIMES(CONFIG_DELAY_T0H)		\
			SET_LOW					\
			NOP_N_TIMES(CONFIG_DELAY_T0L)		\
			::					\
			[r] "l" (base),				\
			[p] "l" (pin)); } while (false)


#if 1
static void send_buf(uint32_t *buf, int len)
{
    volatile uint32_t *base = (uint32_t *)&NRF_P1->OUTSET;
	const uint32_t val = BIT(led_gpio.pin);
	struct onoff_manager *mgr = z_nrf_clock_control_get_onoff(CLOCK_CONTROL_NRF_SUBSYS_HF);

	struct onoff_client cli;
	unsigned int key;
	int rc;

	sys_notify_init_spinwait(&cli.notify);
	rc = onoff_request(mgr, &cli);
	if (rc < 0) {
		return;
	}

	while (sys_notify_fetch_result(&cli.notify, &rc)) {
		/* pend until clock is up and running */
	}

    key = irq_lock();
	int32_t i;
	int iNum = 0;
	
    while ((iNum++) < len) {
		for (i = 23; i >= 0; i--) {
			if (buf[iNum] & BIT(i)) {
				ONE_BIT(base, val);
			} else {
				ZERO_BIT(base, val);
			}
		}
	}

    irq_unlock(key);

	rc = onoff_release(mgr);
	rc = MIN(rc, 0);
}
#else

static inline void send_bit(uint8_t bit)
{
    // gpio_pin_set_dt(&led_gpio, 1);
	gpio_pin_set_raw(led_gpio.port, led_gpio.pin, 1);
    if (bit) {
        k_busy_wait(650);
        // gpio_pin_set_dt(&led_gpio, 0);
		gpio_pin_set_raw(led_gpio.port, led_gpio.pin, 0);
        k_busy_wait(600);
    } else {
        k_busy_wait(300);
        // gpio_pin_set_dt(&led_gpio, 0);
		gpio_pin_set_raw(led_gpio.port, led_gpio.pin, 0);
        k_busy_wait(950);
    }
}

static void send_buf(uint8_t *buf, size_t len)
{
	size_t tLength = len;
	unsigned int key;
    key = irq_lock();

	while (tLength--)
	{
		uint32_t b = *buf++;
		for (int i = 7; i >= 0; i--)
		{
			send_bit((b >> i) & 1);
		}
	}
	irq_unlock(key);
}

static void ws_reset(void)
{
    gpio_pin_set_raw(led_gpio.port, led_gpio.pin, 0);
    k_busy_wait(60000);
}

#endif

static void ws2811_gpio_update_rgb(struct LED_RGB_T *pixels, uint8_t num_pixels)
{
    uint32_t uiGpioBuff[8] = {0};
    for(int i = 0; i < num_pixels; i++)
    {
		uiGpioBuff[i] = pixels->r + (pixels->g << 8) + (pixels->b << 16);
    }

    send_buf(uiGpioBuff, num_pixels);

	// gpio_pin_set_raw(led_gpio.port, led_gpio.pin, 1);
	// ws_reset();
}

static uint8_t uiNum = 0;
void led_updatergb()
{
	ws2811_gpio_update_rgb(rgbcolors + uiNum, 2);
	uiNum = (uiNum + 1) % 9;
	
}

void ws2811_init()
{
    int err = 0;

	if (!gpio_is_ready_dt(&led_gpio)) {
		return;
	}

    err = gpio_pin_configure_dt(&led_gpio, GPIO_OUTPUT);
    if (err) {
        LOG_ERR("Cannot configure LED gpio");
    }
	err = gpio_pin_set_raw(led_gpio.port, led_gpio.pin, 0);
	 
	// err = gpio_pin_set_dt(&led_gpio, 1);
	if (err) {
		printf("Cannot write LED gpio");
	}

	// k_msleep(1000 * 5);

	// err = gpio_pin_set_raw(led_gpio.port, led_gpio.pin, 0);
	 
	// // err = gpio_pin_set_dt(&led_gpio, 1);
	// if (err) {
	// 	printf("Cannot write LED gpio");
	// }

	// k_msleep(1000 * 5);
}