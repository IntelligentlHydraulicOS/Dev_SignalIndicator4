/ {

	/delete-node/ leds;
	/delete-node/ buttons;
	/delete-node/ pwmleds;

	aliases{
		/delete-property/ led0;
		/delete-property/ led1;
		/delete-property/ led2;
		/delete-property/ led3;
		/delete-property/ sw0;
		/delete-property/ sw1;
		/delete-property/ sw2;
		/delete-property/ sw3;
		/delete-property/ pwm-led0;
		/delete-property/ mcuboot-button0;
		/delete-property/ mcuboot-led0;
	};

	nordic_expansion_header: nordic_expansion_header {
		/delete-property/ gpio-map-mask;
		/delete-property/ gpio-map-pass-thru;
		/delete-property/ gpio-map;
		/delete-property/ compatible;
		/delete-property/ #gpio-cells;
		status = "disabled";
	};

	chosen {
		zephyr,console = &uart30;
		zephyr,shell-uart = &uart30;
	};

	// /delete-node/ nordic_expansion_header;

	heart_led: heart-led {
		compatible = "nordic,gpio-pins";
		gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;
		status = "okay";
	};

	//rs485_gpio: rs485-gpio {
    //    compatible = "nordic,gpio-pins";
    //    gpios = <&gpio1 6 GPIO_ACTIVE_HIGH>;
    //    status = "okay";
    //};

	dw3000_irq: dw3000-irq {
		compatible = "nordic,gpio-pins";
		gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	dw3000_rst: dw3000-rst {
		compatible = "nordic,gpio-pins";
		gpios = <&gpio2 10 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	dw3000_wakeup: dw3000-wakeup {
		compatible = "nordic,gpio-pins";
		gpios = <&gpio2 7 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	// dw3000_cs: dw3000-cs {
    //     compatible = "nordic,gpio-pins";
    //     gpios = <&gpio2 5 GPIO_ACTIVE_HIGH>;
    //     status = "okay";
    // };

	dw3000_pd: dw3000-pd {
		compatible = "nordic,gpio-pins";
		gpios = <&gpio2 0 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	//dw3000_sync: dw3000-sync {
    //    compatible = "nordic,gpio-pins";
    //    gpios = <&gpio0 3 GPIO_ACTIVE_LOW>;
    //    status = "okay";
    //};

	zigbee_mode: zigbee-mode {
		compatible = "nordic,gpio-pins";
		gpios = <&gpio2 3 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	zigbee_m01: zigbee-m01 {
		compatible = "nordic,gpio-pins";
		gpios = <&gpio0 1 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	// zigbee_m00: zigbee-m00 {
	// 	compatible = "nordic,gpio-pins";
	// 	gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
	// 	status = "okay";
	// };

	zigbee_link: zigbee-link {
		compatible = "nordic,gpio-pins";
		gpios = <&gpio2 4 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	zigbee_connect: zigbee-connect {
		compatible = "nordic,gpio-pins";
		gpios = <&gpio2 1 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	uwb_connect: uwb-connect {
		compatible = "nordic,gpio-pins";
		gpios = <&gpio2 2 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	pca9635_oe: pca9635-oe {
		compatible = "nordic,gpio-pins";
		gpios = <&gpio1 14 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	pca9635_key: pca9635-key {
		compatible = "nordic,gpio-pins";
		gpios = <&gpio1 9 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};
};

&pinctrl{
	/omit-if-no-ref/ uart20_only_default: uart20_only_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 6)>;
		};

		group2 {
			psels = <NRF_PSEL(UART_RX, 1, 7)>;
			bias-pull-up;
		};
	};

	/omit-if-no-ref/ uart20_only_sleep: uart20_only_sleep {
		group1 {
			psels = <NRF_PSEL(UART_RX, 1, 7)>;
			low-power-enable;
		};

		group2 {
			psels = <NRF_PSEL(UART_TX, 1, 6)>;
			low-power-enable;
			bias-pull-up;
		};
	};

	/omit-if-no-ref/ uart21_only_default: uart21_only_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 12)>;//P1.12
		};

		group2 {
			psels = <NRF_PSEL(UART_RX, 1, 13)>;
			bias-pull-up;
		};
	};

	/omit-if-no-ref/ uart21_only_sleep: uart21_only_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 12)>,
				<NRF_PSEL(UART_RX, 1, 13)>;
			// bias-pull-up;
			low-power-enable;
		};
	};

	/omit-if-no-ref/ uart30_only_default: uart30_only_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 0)>;
			// bias-pull-up;
		};
	};

	/omit-if-no-ref/ uart30_only_sleep: uart30_only_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 0)>;
			bias-pull-up;
			low-power-enable;
		};
	};

	/omit-if-no-ref/ spi00_default: spi00_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 2, 6)>,
				<NRF_PSEL(SPIM_MOSI, 2, 8)>,
				<NRF_PSEL(SPIM_MISO, 2, 9)>;
		};
	};

	/omit-if-no-ref/ spi00_sleep: spi00_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 2, 6)>,
				<NRF_PSEL(SPIM_MOSI, 2, 8)>,
				<NRF_PSEL(SPIM_MISO, 2, 9)>;
			low-power-enable;
		};
	};

	/omit-if-no-ref/ i2c21_default: i2c21_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SCL, 1, 11)>,
                    <NRF_PSEL(TWIM_SDA, 1, 10)>;
        };
    };
    /omit-if-no-ref/ i2c21_sleep: i2c21_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SCL, 1, 11)>,
                    <NRF_PSEL(TWIM_SDA, 1, 10)>;
        };
    };
};

//RS485
&uart20 {
	current-speed = <115200>;
	pinctrl-0 = <&uart20_only_default>;
	pinctrl-1 = <&uart20_only_sleep>;
	pinctrl-names = "default", "sleep";
	status = "okay";
};

//zigbee
&uart22 {
	current-speed = <115200>;
	pinctrl-0 = <&uart21_only_default>;
	pinctrl-1 = <&uart21_only_sleep>;
	pinctrl-names = "default", "sleep";
	status = "okay";
};

&uart30 {
	current-speed = <115200>;
	pinctrl-0 = <&uart30_only_default>;
	pinctrl-1 = <&uart30_only_sleep>;
	pinctrl-names = "default", "sleep";
	disable-rx;  /* 禁用接收 */
	status = "okay";
};

&pwm20{
	/delete-property/ pinctrl-0;
	/delete-property/ pinctrl-1;
	/delete-property/ pinctrl-names;
	status = "disabled";
};

/* 将 NFC 引脚释放为 GPIO */
&uicr {
    nfct-pins-as-gpios;
};

&nfct {
	status = "disabled";
};

&adc {
	status = "disabled";
};

nordic_expansion_spi: &spi22 {
	status = "disabled";
};

&lfxo {
    load-capacitors = "external";
    load-capacitance-femtofarad = <12000>;
};

&spi00 {
	status = "okay";
	cs-gpios = <&gpio2 5 GPIO_ACTIVE_HIGH>;
	pinctrl-0 = <&spi00_default>;
	pinctrl-1 = <&spi00_sleep>;
	pinctrl-names = "default", "sleep";

	/delete-node/ mx25r6435f@0;
};

&spi22 {
	status = "disabled";
};

&i2c21 {
    status = "okay";
    pinctrl-0 = <&i2c21_default>;
    pinctrl-1 = <&i2c21_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <I2C_BITRATE_FAST>;

    nxp_pca9635pw: nxp-pca9635pw@01 {
        compatible = "nxp,pca9635";
        reg = <0x1>;
    };

    hxy_bma253: hxy-bma253@19 {
        compatible = "hxy,bma253";
        reg = <0x19>;
    };
};

