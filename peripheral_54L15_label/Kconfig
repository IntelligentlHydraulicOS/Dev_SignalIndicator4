source "Kconfig.zephyr"

config SETTINGS
	default y

config ZMS
	select CRC
	default y if (SOC_FLASH_NRF_RRAM || SOC_FLASH_NRF_MRAM)

config NVS
	default y if !(SOC_FLASH_NRF_RRAM || SOC_FLASH_NRF_MRAM)

config APP_SYSTEM_ON_IDLE_CALLBACK
	bool
	default y
	select ARM_ON_ENTER_CPU_IDLE_HOOK

config APP_NFC_CONFIG_PIN
	string "PIN required in NFC configuration records"
	default ""
	help
	  PIN required in writable NFC NDEF configuration records. Keep this
	  value out of version control. The PIN is embedded in firmware and is
	  intended only to prevent accidental nearby writes, not as strong
	  authentication.
