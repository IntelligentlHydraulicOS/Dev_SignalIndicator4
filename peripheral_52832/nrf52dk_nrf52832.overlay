

/ {

	/delete-node/ leds;
	/delete-node/ buttons;
	/delete-node/ pwmleds;

	/delete-node/ arduino_header;
	/delete-node/ arduino_adc;
	aliases{
		/delete-property/ led0;
		/delete-property/ led1;
		/delete-property/ led2;
		/delete-property/ led3;
		/delete-property/ sw0;
		/delete-property/ sw1;
		/delete-property/ sw2;
		/delete-property/ sw3;
		/delete-property/ pwm-led0;
		/delete-property/ mcuboot-button0;
		/delete-property/ mcuboot-led0;
		bq27441 = &bq27441_sensor;
		lsm6ds3-int1 = &lsm6ds3_int1;
	};

	dw1000_irq: dw1000-irq {
        compatible = "nordic,gpio-pins";
        gpios = <&gpio0 31 GPIO_ACTIVE_LOW>;
        status = "okay";
    };

	dw1000_rst: dw1000-rst {
        compatible = "nordic,gpio-pins";
        gpios = <&gpio0 26 GPIO_ACTIVE_HIGH>;
        status = "okay";
    };

	dw1000_wakeup: dw1000-waleup {
        compatible = "nordic,gpio-pins";
        gpios = <&gpio0 27 GPIO_ACTIVE_HIGH>;
        status = "okay";
    };

	dw1000_cs: dw1000-cs {
        compatible = "nordic,gpio-pins";
        gpios = <&gpio0 25 GPIO_ACTIVE_HIGH>;
        status = "okay";
    };
    	lsm6ds3_cs: lsm6ds3-cs {
        compatible = "nordic,gpio-pins";
        gpios = <&gpio0 22 GPIO_ACTIVE_HIGH>;
        status = "okay";
    };
    	lsm6ds3_int1: lsm6ds3-int1 {
	compatible = "ti,lsm6ds3";
        gpios = <&gpio0 23 GPIO_PULL_UP>;
        status = "okay";
    };
};



&pinctrl {
	spi1_default: spi1_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 11)>,
					<NRF_PSEL(SPIM_MOSI, 0, 12)>,
					<NRF_PSEL(SPIM_MISO, 0, 13)>;
		};
	};

	spi1_sleep: spi1_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 11)>,
					<NRF_PSEL(SPIM_MOSI, 0, 12)>,
					<NRF_PSEL(SPIM_MISO, 0, 13)>;
			low-power-enable;
		};
	};

	spi2_default: spi2_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 6)>,
					<NRF_PSEL(SPIM_MOSI, 0, 7)>,
					<NRF_PSEL(SPIM_MISO, 0, 8)>;
		};
	};

	spi2_sleep: spi2_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 6)>,
					<NRF_PSEL(SPIM_MOSI, 0, 7)>,
					<NRF_PSEL(SPIM_MISO, 0, 8)>;
			low-power-enable;
		};
	};

	uart0_default: uart0_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 17)>,
				<NRF_PSEL(UART_RX, 0, 19)>;
		};
	};

	uart0_sleep: uart0_sleep {
		group1 {
			psels = <NRF_PSEL(UART_RX, 0, 19)>;
			low-power-enable;
		};

		group2 {
			psels = <NRF_PSEL(UART_TX, 0, 17)>;
			low-power-enable;
			bias-pull-up;
		};
	};

	i2c0_default: i2c0_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 2)>,
				    <NRF_PSEL(TWIM_SCL, 0, 3)>;
		};
	};

	i2c0_sleep: i2c0_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 2)>,
				    <NRF_PSEL(TWIM_SCL, 0, 3)>;
			low-power-enable;
		};
	};
};

&spi1 {
	compatible = "nordic,nrf-spi";
	status = "okay";
	pinctrl-0 = <&spi1_default>;
	pinctrl-1 = <&spi1_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio0 25 GPIO_ACTIVE_HIGH>;
};

&spi2 {
	status = "okay";
	pinctrl-0 = <&spi2_default>;
	pinctrl-1 = <&spi2_sleep>;
	pinctrl-names = "default", "sleep";

	cs-gpios = <&gpio0 22 GPIO_ACTIVE_LOW>;

	lsm6ds3: lsm6ds3@0 {
		compatible = "st,lsm6ds3";
		reg = <0>;
		spi-max-frequency = <10000000>;
		frame-format = "spi-mode-0";
	};
};

&pwm0 {
	status = "disabled";
};

arduino_serial: &uart0 {
	status = "okay";
	compatible = "nordic,nrf-uarte";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-1 = <&uart0_sleep>;
	pinctrl-names = "default", "sleep";
};

&i2c0 {
	status = "okay";
	pinctrl-0 = <&i2c0_default>;
	pinctrl-1 = <&i2c0_sleep>;
	pinctrl-names = "default", "sleep";
	clock-frequency = <I2C_BITRATE_STANDARD>;

	bq27441_sensor: bq27441@55 {
		compatible = "ti,bq27441";
		reg = <0x55>;
		status = "okay";
	};
};



